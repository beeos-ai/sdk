{
  "name": "@beeos-ai/sdk",
  "version": "0.6.0",
  "description": "OpenAPI client for @beeos-ai/sdk",
  "author": "OpenAPI-Generator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beeos-ai/sdk.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/esm/index.js",
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/clean-dist.cjs && tsc --emitDeclarationOnly && esbuild src/index.ts src/facade.ts --bundle --format=cjs --platform=node --target=node20 --outdir=dist && esbuild src/index.ts src/facade.ts --bundle --format=esm --platform=node --target=node20 --outdir=dist/esm && node scripts/write-esm-package.cjs",
    "test": "node --test test/*.test.cjs"
  },
  "devDependencies": {
    "typescript": "^4.0 || ^5.0",
    "esbuild": "^0.25.0"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./facade": {
      "types": "./dist/facade.d.ts",
      "import": "./dist/esm/facade.js",
      "require": "./dist/facade.js",
      "default": "./dist/facade.js"
    }
  }
}
